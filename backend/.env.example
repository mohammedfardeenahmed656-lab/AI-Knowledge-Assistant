# =================================================================
# AI Knowledge Assistant (RAG Pipeline) Configuration
# =================================================================

# Server Network Settings
HOST=127.0.0.1
PORT=8000
ENV=development

# LLM Providers (Optional: system works 100% offline out-of-the-box!)
# If GEMINI_API_KEY is supplied, Google Gemini 1.5 Flash will be used.
# If OPENAI_API_KEY is supplied, OpenAI GPT-4o-mini will be used.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Preferred Model Names
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Ingestion Hyperparameters
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100

# RAG Retrieval Hyperparameters
DEFAULT_TOP_K=4
DEFAULT_SIMILARITY_THRESHOLD=0.20

# Hybrid Search Weight (1.0 = Pure Vector, 0.0 = Pure Keyword BM25, 0.7 = Recommended Hybrid)
DEFAULT_HYBRID_ALPHA=0.7